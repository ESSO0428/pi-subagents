{
  "name": "@esso0428/pi-subagents",
  "version": "0.17.29",
  "description": "A pi extension that brings smart Claude Code-style autonomous sub-agents to pi, with npm:pi-subagents-style JSON agent overrides.",
  "author": "ESSO0428",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ESSO0428/pi-subagents.git"
  },
  "homepage": "https://github.com/ESSO0428/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/ESSO0428/pi-subagents/issues"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.8",
    "@earendil-works/pi-coding-agent": ">=0.80.8",
    "@earendil-works/pi-tui": ">=0.80.8",
    "@sinclair/typebox": "*"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "nanoid": "^5.0.0",
    "@shikijs/cli": "^4.0.2"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://github.com/tintinweb/pi-subagents/raw/master/media/demo.mp4",
    "image": "https://github.com/tintinweb/pi-subagents/raw/master/media/screenshot.png"
  }
}
